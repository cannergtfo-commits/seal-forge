[Unit]
Description=Seal Forge table
After=network.target

[Service]
WorkingDirectory=/opt/seal-forge
Environment=SEAL_FORGE_TABLE=1
Environment=SEAL_FORGE_SIGNER=
EnvironmentFile=-/etc/seal-forge.env
ExecStart=/usr/bin/npm run dev
Restart=on-failure
RestartSec=3
User=sealforge

[Install]
WantedBy=multi-user.target
